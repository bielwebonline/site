{
  "version": 2,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{"key": "Content-Type", "value": "application/xml"}]
    },
    {
      "source": "/robots.txt",
      "headers": [{"key": "Content-Type", "value": "text/plain"}]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
      ]
    }
  ],
  "routes": [
    {"src": "/api/chat", "dest": "/api/chat.js"},
    {"src": "/(.*)", "dest": "/$1"}
  ]
}
